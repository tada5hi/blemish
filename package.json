{
    "name": "blemish",
    "version": "1.0.1",
    "type": "module",
    "description": "A dependency-free issue tree model: nested item/group issues with absolute paths, shared across validation libraries.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tada5hi/blemish.git"
    },
    "main": "dist/index.cjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build:types": "tsc --noEmit",
        "build:js": "tsdown",
        "build": "npm run build:types && npm run build:js",
        "test": "vitest --config test/vitest.config.ts --run",
        "test:coverage": "vitest --config test/vitest.config.ts --run --coverage",
        "lint": "eslint",
        "lint:fix": "npm run lint -- --fix",
        "prepare": "husky"
    },
    "keywords": [
        "issue",
        "issues",
        "validation",
        "error",
        "tree",
        "i18n",
        "typescript",
        "esm"
    ],
    "publishConfig": {
        "access": "public"
    },
    "license": "MIT",
    "devDependencies": {
        "@tada5hi/commitlint-config": "^1.3.1",
        "@tada5hi/eslint-config": "^2.3.0",
        "@tada5hi/tsconfig": "^0.7.2",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^10.3.0",
        "husky": "^9.1.7",
        "tsdown": "^0.22.14",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.2",
        "vitest": "^4.1.5"
    }
}
